LIBS := work
LIB_IND := work/.work
## rules #################################
sim: modelsim.ini $(LIB_IND) $(VERILOG_OBJ) $(VHDL_OBJ)
$(VERILOG_OBJ): $(VHDL_OBJ) 
$(VHDL_OBJ): $(LIB_IND) modelsim.ini

modelsim.ini: $(MODELSIM_INI_PATH)/modelsim.ini
		cp $< .
clean:
		rm -rf ./modelsim.ini $(LIBS)
.PHONY: clean

work/.work:
	(vlib work && vmap -modelsimini modelsim.ini work && touch work/.work )|| rm -rf work 

work/sockit_owm/.sockit_owm_v: ../../whiteRabbit/wr-cores/ip_cores/general-cores/modules/wishbone/wb_onewire_master/sockit_owm.v 
		vlog -work work $(VLOG_FLAGS) +incdir+../../whiteRabbit/wr-cores/ip_cores/general-cores/modules/wishbone/wb_onewire_master  $<
		@mkdir -p $(dir $@) && touch $@ 


